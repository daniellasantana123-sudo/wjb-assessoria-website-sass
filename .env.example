# Copie para .env.local (dev) ou configure direto no ambiente de produção.
# NUNCA preencha valores reais neste arquivo - ele é versionado no Git.
# Criado na Fase 6.5 (mocks/contratos internos Omie.G-Click, 2026-09-20) -
# pendência conhecida desde a auditoria da Fase 0.
#
# ATENÇÃO (2026-09-23): tudo que começa com NEXT_PUBLIC_ é embutido no
# código durante o BUILD, não lido em tempo de execução. Salvar/alterar
# essas variáveis no painel da hospedagem NÃO tem efeito sozinho - é
# preciso um deploy novo depois. Na Hostinger, um commit vazio
# (`git commit --allow-empty`) não dispara o build: use um commit com
# alteração real de arquivo, ou o botão de deploy manual do painel.
# As demais (sem o prefixo, ex.: RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY)
# são lidas em tempo de execução e valem após reiniciar a aplicação.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://wjbassessoriacontabil.com.br

# --- Supabase (Auth, Postgres, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flag do SaaS (Portal/Admin) ---
# "true" libera /login, /portal, /admin publicamente. Manter ausente/false
# até o lançamento público da Plataforma SaaS (ver src/proxy.ts).
NEXT_PUBLIC_SAAS_PUBLIC_ENABLED=false

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp Business Platform (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LEAD_TEMPLATE_NAME=

# --- Analytics (nenhum provider confirmado ainda) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Google Maps (endereço em /contato) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Omie.G-Click (integração real implementada em 2026-09-23) ---
# GCLICK_MODE: mock | sandbox | production. "mock" continua sendo o padrão
# e não exige nenhuma credencial. "sandbox"/"production" usam a API real
# (https://api.gclick.com.br) - a G-Click não publica host de sandbox
# separado, então os dois batem no mesmo lugar.
GCLICK_MODE=mock

# Proteção: com GCLICK_MODE=sandbox/production, nenhuma chamada de rede
# acontece a menos que isto seja exatamente "true". Serve como interruptor
# de emergência - desligar aqui derruba a integração sem redeploy de código.
GCLICK_REAL_INTEGRATION_ENABLED=false

# Credenciais: painel do G-Click > Configurações > Integrações & API >
# aba API > "+ Criar uma Aplicação". NUNCA são do Omie ERP - são sistemas
# diferentes. Fluxo confirmado: OAuth client_credentials em POST
# /oauth/token (ver docs/integrations/gclick/PENDING_VALIDATION.md).
GCLICK_CLIENT_ID=
GCLICK_CLIENT_SECRET=
# Só preencher pra apontar pra outro host (o padrão já é o oficial).
GCLICK_BASE_URL=
GCLICK_TIMEOUT_MS=10000

# Configuração específica da conta da WJB no G-Click - a API exige esses
# ids e eles variam por conta, então não têm padrão possível. Listar com
# GET /visibilidades e GET /grupos depois de autenticar.
# GCLICK_VISIBILIDADE_IDS é OBRIGATÓRIO pra criar cliente (aceita lista:
# "1,2"). GCLICK_DEPARTAMENTO_ID é obrigatório pra criar pré-tarefa e sai
# da própria tela do G-Click (GET /departamentos é partner_only).
GCLICK_VISIBILIDADE_IDS=
GCLICK_GRUPO_IDS=
GCLICK_DEPARTAMENTO_ID=
# FIXO (padrão) ou EVENTUAL - regra de negócio da WJB, não da API.
GCLICK_CLIENTE_TIPO=FIXO
# Identificador do sistema integrador gravado no cadastro do cliente.
GCLICK_SISTEMA=

# --- Testes E2E (Playwright) ---
E2E_TEST_EMAIL_CLIENT=
E2E_TEST_EMAIL_CLIENT_TICKETS=
E2E_TEST_EMAIL_STAFF=
E2E_TEST_PASSWORD=
