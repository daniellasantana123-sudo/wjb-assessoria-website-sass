# Copie para .env.local (dev) ou configure direto no ambiente de produção.
# NUNCA preencha valores reais neste arquivo - ele é versionado no Git.
# Criado na Fase 6.5 (mocks/contratos internos Omie.G-Click, 2026-09-20) -
# pendência conhecida desde a auditoria da Fase 0.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://wjbassessoriacontabil.com.br

# --- Supabase (Auth, Postgres, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flag do SaaS (Portal/Admin) ---
# "true" libera /login, /portal, /admin publicamente. Manter ausente/false
# até o lançamento público da Plataforma SaaS (ver src/proxy.ts).
NEXT_PUBLIC_SAAS_PUBLIC_ENABLED=false

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp Business Platform (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LEAD_TEMPLATE_NAME=

# --- Analytics (nenhum provider confirmado ainda) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Google Maps (endereço em /contato) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Omie.G-Click (Fase 6.5 - mocks e contratos internos) ---
# GCLICK_MODE: mock | sandbox | production. "mock" é o único modo
# funcional hoje - "sandbox"/"production" caem num provider sempre
# bloqueado (ver src/integrations/omie-gclick/http.provider.ts) até a
# especificação técnica oficial da G-Click ser confirmada.
GCLICK_MODE=mock

# Trava de segurança extra: mesmo com GCLICK_MODE=production, a
# integração real só seria considerada se isto fosse "true" - hoje não
# tem efeito prático (não existe implementação real), é uma proteção
# preparada para quando existir.
GCLICK_REAL_INTEGRATION_ENABLED=false

# TODO_GCLICK_VALIDATION - nomes/formato ainda não confirmados pela
# documentação oficial da G-Click (ver
# artifacts/wjb-saas-mvp/fase-6-5/credentials-model.md e
# docs/integrations/gclick/PENDING_VALIDATION.md). Não preencher com
# credenciais do Omie ERP - são sistemas diferentes.
GCLICK_BASE_URL=
GCLICK_CLIENT_ID=
GCLICK_CLIENT_SECRET=
GCLICK_API_KEY=
GCLICK_TOKEN=
GCLICK_TIMEOUT_MS=10000

# --- Testes E2E (Playwright) ---
E2E_TEST_EMAIL_CLIENT=
E2E_TEST_EMAIL_CLIENT_TICKETS=
E2E_TEST_EMAIL_STAFF=
E2E_TEST_PASSWORD=
